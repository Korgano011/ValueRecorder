        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Value Recorder can add your voice from the microphone to a screen recording.",
        "INFOPLIST_KEY_NSSpeechRecognitionUsageDescription": "Value Recorder turns the audio in your recordings into text on this Mac.",
